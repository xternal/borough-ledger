 "topics": {
  "adult_care": [
   {
    "who": "law",
    "text": "The council must assess anyone who appears to need care and support, and meet the needs that are eligible.",
    "source_ids": [
     "care_act_2014_s9",
     "care_act_2014_s18"
    ],
    "where": "",
    "quality": "sourced"
   },
   {
    "who": "government",
    "text": "The government sets most of the council's money, and how far council tax can rise.",
    "source_ids": [
     "lgfs_2026-27_response"
    ],
    "where": "",
    "quality": "sourced"
   },
   {
    "who": "council",
    "text": "The council chooses the prices it pays care homes and home care agencies, how much goes on helping people stay at home, and whether to charge for care, which the law allows but does not require.",
    "source_ids": [
     "care_act_2014_s14"
    ],
    "where": "",
    "quality": "sourced"
   },
   {
    "who": "council",
    "text": "Hammersmith & Fulham has not charged for care at home since April 2015; its own report says it is the only council in England not to.",
    "source_ids": [
     "lbhf_free_home_care_2024-10-17"
    ],
    "where": "page 1",
    "quality": "sourced"
   }
  ],
  "council_tax": [
   {
    "who": "law",
    "text": "Raising council tax by more than the government's limit needs a local referendum.",
    "source_ids": [
     "lgfa1992_s52zb"
    ],
    "where": "",
    "quality": "sourced"
   },
   {
    "who": "government",
    "text": "For 2027/28 and 2028/29 the government has said it will set no limit for Hammersmith & Fulham and five other councils with low council tax, so no referendum would be needed.",
    "source_ids": [
     "lgfs_2026-27_response"
    ],
    "where": "",
    "quality": "sourced"
   },
   {
    "who": "council",
    "text": "Cabinet proposes the rise and Full Council sets it, with the budget.",
    "source_ids": [
     "cabinet_mtfs_2026-10-12"
    ],
    "where": "page 19",
    "quality": "sourced"
   }
  ],
  "budget": [
   {
    "who": "law",
    "text": "The council must set a budget that balances: what it spends is paid for by council tax, grants and other income, or reserves.",
    "source_ids": [
     "lgfa1992_s31a"
    ],
    "where": "",
    "quality": "sourced"
   },
   {
    "who": "government",
    "text": "The government sets most of the council's money, and how far council tax can rise.",
    "source_ids": [
     "lgfs_2026-27_response"
    ],
    "where": "",
    "quality": "sourced"
   },
   {
    "who": "council",
    "text": "Cabinet proposes the budget and Full Council sets it: which services to fund, what to save and how much to raise council tax.",
    "source_ids": [
     "cabinet_mtfs_2026-10-12"
    ],
    "where": "page 19",
    "quality": "sourced"
   }
  ],
  "streets_waste": [
   {
    "who": "law",
    "text": "The council must collect household waste, and keep the roads and pavements it is responsible for in repair.",
    "source_ids": [
     "epa_1990_s45",
     "highways_act_1980_s41"
    ],
    "where": "",
    "quality": "approx"
   },
   {
    "who": "government",
    "text": "The government sets most of the council's money, and how far council tax can rise.",
    "source_ids": [
     "lgfs_2026-27_response"
    ],
    "where": "",
    "quality": "approx"
   },
   {
    "who": "council",
    "text": "How often bins are collected and streets are swept is for the council: the law sets the duty, not how often.",
    "source_ids": [
     "epa_1990_s45"
    ],
    "where": "",
    "quality": "approx"
   },
   {
    "who": "council",
    "text": "The council decides where you can park on its roads and what it charges; the money it raises is taken off this spending.",
    "source_ids": [
     "rtra_1984_s45"
    ],
    "where": "",
    "quality": "approx"
   }
  ],
  "libraries_leisure": [
   {
    "who": "law",
    "text": "The council must run a comprehensive and efficient library service for everyone who wants to use it.",
    "source_ids": [
     "plma_1964_s7"
    ],
    "where": "",
    "quality": "approx"
   },
   {
    "who": "government",
    "text": "The Secretary of State can step in where a council fails that duty, and the government sets most of the council's money.",
    "source_ids": [
     "plma_1964_s10",
     "lgfs_2026-27_response"
    ],
    "where": "",
    "quality": "approx"
   },
   {
    "who": "council",
    "text": "Within that duty, the council chooses how many libraries to keep and when they open, and how much to spend on parks, leisure centres and the arts.",
    "source_ids": [
     "plma_1964_s7"
    ],
    "where": "",
    "quality": "approx"
   }
  ],
  "housing": [
   {
    "who": "law",
    "text": "The council must try to prevent or end homelessness for anyone eligible, and must give temporary accommodation to people who may be in priority need, such as families with children, while it decides what it owes them.",
    "source_ids": [
     "ha_1996_s189b",
     "ha_1996_s188",
     "ha_1996_s189"
    ],
    "where": "",
    "quality": "approx"
   },
   {
    "who": "government",
    "text": "The government sets most of the council's money, and how far council tax can rise.",
    "source_ids": [
     "lgfs_2026-27_response"
    ],
    "where": "",
    "quality": "approx"
   },
   {
    "who": "council",
    "text": "The council decides who comes first for council and housing association homes, in its own allocation scheme, and how much it spends on preventing homelessness.",
    "source_ids": [
     "ha_1996_s166a"
    ],
    "where": "",
    "quality": "approx"
   }
  ]
 },
