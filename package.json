{
  "name": "borough-ledger",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": { "node": ">=22.12 <23 || >=24" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:preview": "pnpm --filter @borough-ledger/web build:preview",
    "build:prod": "pnpm --filter @borough-ledger/web build:prod",
    "dev": "pnpm --filter @borough-ledger/web dev",
    "check:dots": "node scripts/check-no-middle-dot.mjs",
    "prototype": "python3 build_prototype.py"
  }
}
