{
  "name": "@borough-ledger/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content-compile.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "report:test-values": "tsx src/report-test-values.ts",
    "content:build": "tsx src/content-build.ts",
    "content:check": "tsx src/content-build.ts --check",
    "content:append-only": "tsx src/append-only-cli.ts",
    "content:deadlines": "tsx src/deadlines-cli.ts",
    "decisions:suggest": "tsx src/decision-links-cli.ts suggest",
    "decisions:apply": "tsx src/decision-links-cli.ts apply",
    "decisions:probe": "tsx src/decision-links-cli.ts probe",
    "digest": "tsx src/digest-cli.ts",
    "promises:quotes": "tsx src/promise-quotes-cli.ts",
    "promises:manifesto": "tsx src/manifesto-cli.ts"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
